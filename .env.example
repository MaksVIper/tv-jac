NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jaco_tv
DB_PASSWORD=change-me
DB_MAIN_DATABASE=jaco_main_rolls
DB_CONNECTION_LIMIT=10
APP_TIMEZONE=Europe/Samara
TIME_READY_SHOW_MINUTES=5
TIME_FINISH_SHOW_MINUTES=1

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

LOG_LEVEL=error
LOG_DIR=logs
GLOBAL_RATE_LIMIT_PER_MINUTE=180
POLL_RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=100
